  <!-- ==========================================================================
       OWNER STUDIO COMMAND CENTER (DEDICATED OWNER STUDIO)
       ========================================================================== -->
  <div id="studioView" style="display: none;">
    <div class="admin-container">
      <div class="admin-header">
        <div class="admin-title-group">
          <h2>
            <span class="brand-name-display">PulseLive</span>
            <span style="font-size: 1rem; color: var(--text-muted); font-weight: 500;">/ Owner Studio</span>
            <span class="owner-shield">OWNER COMMAND CENTER</span>
          </h2>
        </div>
        <div>
          <button class="glow-btn" style="padding: 8px 18px; border-radius: var(--radius-md);" onclick="ownerStudio.closeStudio()">
            ← Back to App
          </button>
        </div>
      </div>

      <!-- Studio Navigation Tabs -->
      <div class="admin-tabs">
        <button class="admin-tab-btn studio-tab-btn active" data-tab="reality">📊 Reality Pulse</button>
        <button class="admin-tab-btn studio-tab-btn" data-tab="payments">
          💳 Payment Verifications <span id="pendingPayBadge" class="badge badge-banned" style="display:none; font-size:11px;">0</span>
        </button>
        <button class="admin-tab-btn studio-tab-btn" data-tab="users">👥 User Freedom &amp; Control</button>
        <button class="admin-tab-btn studio-tab-btn" data-tab="coins">🪙 Coin Store &amp; Pricing</button>
        <button class="admin-tab-btn studio-tab-btn" data-tab="theme">🎨 Live Glass &amp; Theme Studio</button>
        <button class="admin-tab-btn studio-tab-btn" data-tab="config">⚙️ Granular App Configurator</button>
        <button class="admin-tab-btn studio-tab-btn" data-tab="reports">🚨 Abuse Reports</button>
        <button class="admin-tab-btn studio-tab-btn" data-tab="logs">📜 Audit Trail</button>
      </div>

      <!-- TAB 1: REALITY PULSE -->
      <div class="admin-tab-content studio-tab-content active" id="studio-tab-reality">
        <div class="admin-stats-grid">
          <div class="stat-card">
            <span class="stat-label">Real Connected Online Users</span>
            <span class="stat-value" id="studioLiveUsers">0</span>
            <span class="stat-subtext">Live WebSocket connections</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Total Real Registered Accounts</span>
            <span class="stat-value" id="studioTotalUsers">0</span>
            <span class="stat-subtext">Real emails in database</span>
          </div>
          <div class="stat-card revenue">
            <span class="stat-label">Verified Revenue</span>
            <span class="stat-value" id="studioRevenue">₹0</span>
            <span class="stat-subtext">Received &amp; Approved</span>
          </div>
          <div class="stat-card coins">
            <span class="stat-label">Pending Payment Verifications</span>
            <span class="stat-value" style="color:#fbbf24;" id="studioPendingPayments">0</span>
            <span class="stat-subtext">Screenshots waiting for approval</span>
          </div>
          <div class="stat-card calls">
            <span class="stat-label">Live Active Video Calls</span>
            <span class="stat-value" id="studioActiveCalls">0</span>
            <span class="stat-subtext">Two humans currently talking</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Permanent Free VIP Users</span>
            <span class="stat-value" id="studioFreeVipUsers">0</span>
            <span class="stat-subtext">Owner granted free access</span>
          </div>
        </div>

        <div class="admin-table-wrapper" style="margin-top: 2rem;">
          <div class="table-toolbar">
            <h3 style="font-size: 1.1rem; font-weight: 800;">Real Connected Humans Right Now</h3>
          </div>
          <table class="admin-table">
            <thead>
              <tr>
                <th>Username</th>
                <th>Email ID</th>
                <th>Country</th>
                <th>Live Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="studioLiveClientsTbody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 2: PAYMENT VERIFICATIONS WITH SCREENSHOT PROOFS -->
      <div class="admin-tab-content studio-tab-content" id="studio-tab-payments">
        <div class="admin-table-wrapper">
          <div class="table-toolbar">
            <div>
              <h3 style="font-size: 1.1rem; font-weight: 800; color: #fbbf24;">Pending Payment Approvals Desk</h3>
              <p style="font-size: 0.8rem; color: var(--text-muted);">Inspect user payment screenshots and UTR numbers. Approve once you confirm bank receipt.</p>
            </div>
          </div>
          <table class="admin-table">
            <thead>
              <tr>
                <th>User</th>
                <th>Item Requested</th>
                <th>Amount</th>
                <th>UTR Reference</th>
                <th>Screenshot Receipt</th>
                <th>Submitted At</th>
                <th>Owner Decision</th>
              </tr>
            </thead>
            <tbody id="studioPendingPaymentsTbody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 3: USER FREEDOM & CONTROL (MAKE ANY USER FREE) -->
      <div class="admin-tab-content studio-tab-content" id="studio-tab-users">
        <div class="admin-table-wrapper">
          <div class="table-toolbar">
            <div>
              <h3 style="font-size: 1.1rem; font-weight: 800;">Registered User Control Desk</h3>
              <p style="font-size: 0.8rem; color: var(--text-muted);">Make any user ID 100% Free with permanent VIP access, grant custom coins, or ban abusers.</p>
            </div>
            <input type="text" id="studioUserSearch" class="admin-search-input" placeholder="Search by ID, Username or Email...">
          </div>
          <table class="admin-table">
            <thead>
              <tr>
                <th>User Details</th>
                <th>Email Address</th>
                <th>Country / Gender</th>
                <th>Coin Balance</th>
                <th>VIP Status</th>
                <th>Owner Control Actions</th>
              </tr>
            </thead>
            <tbody id="studioUsersTableBody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- TAB 4: COIN STORE & PRICING -->
      <div class="admin-tab-content studio-tab-content" id="studio-tab-coins">
        <div class="admin-card-grid">
          <div class="glass-panel" style="padding: 1.5rem; border-radius: var(--radius-md);">
            <h4 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 1.25rem;">Coin Economy Rules</h4>
            
            <div class="admin-form-group">
              <label>Complimentary Welcome Bonus Coins on Signup</label>
              <input type="number" id="studioWelcomeCoins" class="admin-input" value="200">
            </div>

            <div class="admin-form-group">
              <label>Coins Deducted Per Video Call (Set to 0 for Free Calls)</label>
              <input type="number" id="studioCallCost" class="admin-input" value="5">
            </div>

            <button class="glow-btn" style="width: 100%; padding: 10px; border-radius: var(--radius-md); margin-top: 1rem;" onclick="ownerStudio.saveGranularSettings()">
              Save Coin Rules
            </button>
          </div>

          <div class="glass-panel" style="padding: 1.5rem; border-radius: var(--radius-md);">
            <h4 style="font-size: 1.2rem; font-weight: 800; margin-bottom: 1.25rem;">Store Packages &amp; Pricing</h4>
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Package</th>
                  <th>Coins</th>
                  <th>Price</th>
                  <th>Badge</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="studioPackagesTbody"></tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- TAB 5: GRANULAR APP CONFIGURATOR (BARIK-SE-BARIK CONTROL) -->
      <div class="admin-tab-content studio-tab-content" id="studio-tab-config">
        <div class="glass-panel" style="padding: 2rem; border-radius: var(--radius-lg);">
          <h3 style="font-size: 1.3rem; font-weight: 900; margin-bottom: 1.5rem;">Granular App Configurator</h3>
          <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2rem;">
            Control every detail of the app: brand name, logo, payment UPI QR code, colors, security PIN, and category access modes.
          </p>

          <form id="studioSettingsForm">
            <div class="admin-card-grid">
              <div>
                <div class="admin-form-group">
                  <label>Application Brand Name</label>
                  <input type="text" id="cfgBrandName" class="admin-input" value="PulseLive">
                </div>

                <div class="admin-form-group">
                  <label>Brand Tagline</label>
                  <input type="text" id="cfgBrandTagline" class="admin-input" value="Global Live Random Video Chat">
                </div>

                <div class="admin-form-group">
                  <label>Brand Logo URL</label>
                  <input type="text" id="cfgLogoUrl" class="admin-input" value="/assets/logo.svg">
                </div>

                <div class="admin-form-group">
                  <label>Payment UPI QR Code Image URL</label>
                  <input type="text" id="cfgPaymentQr" class="admin-input" value="/assets/payment-qr.jpg">
                </div>

                <div class="admin-form-group">
                  <label>Receiving UPI ID (VPA)</label>
                  <input type="text" id="cfgUpiId" class="admin-input" value="pulselive@upi">
                </div>

                <div class="admin-form-group">
                  <label>UPI Payee Name</label>
                  <input type="text" id="cfgUpiName" class="admin-input" value="PulseLive Official">
                </div>

                <div class="admin-form-group">
                  <label>🔑 Owner Studio Security Passcode / PIN (Leave empty to keep current)</label>
                  <input type="text" id="cfgSecurityPin" class="admin-input" placeholder="e.g. 7890">
                </div>
              </div>

              <div>
                <div class="admin-form-group">
                  <label>Theme Primary Accent Color</label>
                  <input type="color" id="cfgThemeAccent" value="#8b5cf6" style="width: 100%; height: 45px; border-radius: 8px; background: transparent; border: 1px solid var(--border-glass); cursor: pointer;">
                </div>

                <div class="admin-form-group">
                  <label>Top Announcement Ticker Text</label>
                  <input type="text" id="cfgAnnouncement" class="admin-input" value="✨ Welcome to PulseLive! Real live video chat. Register now for 200 free coins!">
                </div>

                <div class="admin-form-group">
                  <label>Support Contact Email</label>
                  <input type="email" id="cfgSupportEmail" class="admin-input" value="support@pulselive.io">
                </div>

                <div class="admin-form-group">
                  <label>Category Toggles</label>
                  <div style="display: flex; gap: 1rem; margin-top: 8px;">
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                      <input type="checkbox" id="cfgStrangerCat" checked> Stranger Category
                    </label>
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                      <input type="checkbox" id="cfgFemaleCat" checked> Female Category
                    </label>
                    <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                      <input type="checkbox" id="cfgMaleCat" checked> Male Category
                    </label>
                  </div>
                </div>

                <div class="admin-form-group">
                  <label>Terms &amp; Conditions (18+ Mandate)</label>
                  <textarea id="cfgTerms" class="admin-textarea"></textarea>
                </div>
              </div>
            </div>

            <button type="submit" class="glow-btn" style="padding: 12px 30px; border-radius: var(--radius-md); font-size: 1rem; margin-top: 1rem;">
              💾 Save &amp; Broadcast Live Update
            </button>
          </form>
        </div>
      </div>

      <!-- TAB: LIVE GLASS & THEME STUDIO -->
      <div class="admin-tab-content studio-tab-content" id="studio-tab-theme">
        <div class="admin-table-wrapper" style="padding: 2rem;">
          <div class="table-toolbar">
            <div>
              <h3 style="font-size: 1.25rem; font-weight: 800; color: #fbbf24;">🎨 Realtime Glass Theme &amp; Color Director</h3>
              <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 4px;">Customize website appearance with one-click presets, dynamic glassmorphism blur, and liquid color palettes. Changes reflect instantly!</p>
            </div>
            <button class="glow-btn" id="btnSaveGlassTheme" style="padding: 10px 22px; border-radius: var(--radius-md);">
              💾 Save &amp; Apply Glass Theme
            </button>
          </div>

          <!-- 6 ONE-CLICK GLASS THEME PRESETS -->
          <h4 style="font-size: 0.95rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); margin-top: 1.5rem;">One-Click Glass Theme Presets</h4>
          <div class="theme-presets-grid">
            <div class="theme-preset-card active" data-preset="cyber_violet" onclick="ownerStudio.applyThemePreset('cyber_violet')">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 1rem; color: #f8fafc;">🌌 Cyber Violet Glass</strong>
                <span style="font-size: 0.8rem; color: #c084fc;">Default</span>
              </div>
              <p style="font-size: 0.8rem; color: var(--text-muted);">Obsidian black with electric purple &amp; cyan ambient radiance.</p>
              <div class="preset-preview-bar" style="background: linear-gradient(90deg, #8b5cf6, #06b6d4);"></div>
            </div>

            <div class="theme-preset-card" data-preset="aurora_ice" onclick="ownerStudio.applyThemePreset('aurora_ice')">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 1rem; color: #f8fafc;">💎 Aurora Diamond Glass</strong>
                <span style="font-size: 0.8rem; color: #38bdf8;">Crystalline</span>
              </div>
              <p style="font-size: 0.8rem; color: var(--text-muted);">Midnight royal navy, frosted crystal glass with neon aqua glow.</p>
              <div class="preset-preview-bar" style="background: linear-gradient(90deg, #00f2fe, #4facfe);"></div>
            </div>

            <div class="theme-preset-card" data-preset="amethyst_glow" onclick="ownerStudio.applyThemePreset('amethyst_glow')">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 1rem; color: #f8fafc;">🔮 Electric Amethyst</strong>
                <span style="font-size: 0.8rem; color: #ec4899;">Vivid</span>
              </div>
              <p style="font-size: 0.8rem; color: var(--text-muted);">Deep galactic purple, hot pink glass shimmer &amp; magenta glow.</p>
              <div class="preset-preview-bar" style="background: linear-gradient(90deg, #d946ef, #ec4899);"></div>
            </div>

            <div class="theme-preset-card" data-preset="royal_gold" onclick="ownerStudio.applyThemePreset('royal_gold')">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 1rem; color: #f8fafc;">👑 Royal Noir &amp; Gold</strong>
                <span style="font-size: 0.8rem; color: #fbbf24;">Luxury</span>
              </div>
              <p style="font-size: 0.8rem; color: var(--text-muted);">Pure black obsidian with molten gold and champagne amber sheen.</p>
              <div class="preset-preview-bar" style="background: linear-gradient(90deg, #fbbf24, #f59e0b);"></div>
            </div>

            <div class="theme-preset-card" data-preset="amoled_stealth" onclick="ownerStudio.applyThemePreset('amoled_stealth')">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 1rem; color: #f8fafc;">🌑 AMOLED Pitch Glass</strong>
                <span style="font-size: 0.8rem; color: #a855f7;">Stealth</span>
              </div>
              <p style="font-size: 0.8rem; color: var(--text-muted);">100% pitch black with razor-sharp neon borders and zero light bleed.</p>
              <div class="preset-preview-bar" style="background: linear-gradient(90deg, #a855f7, #3b82f6);"></div>
            </div>

            <div class="theme-preset-card" data-preset="midnight_ocean" onclick="ownerStudio.applyThemePreset('midnight_ocean')">
              <div style="display: flex; justify-content: space-between; align-items: center;">
                <strong style="font-size: 1rem; color: #f8fafc;">🌊 Midnight Ocean</strong>
                <span style="font-size: 0.8rem; color: #06b6d4;">Aquatic</span>
              </div>
              <p style="font-size: 0.8rem; color: var(--text-muted);">Deep oceanic glass with luminous sapphire waves and deep cyan reflections.</p>
              <div class="preset-preview-bar" style="background: linear-gradient(90deg, #06b6d4, #3b82f6);"></div>
            </div>
          </div>

          <!-- FINE-TUNING CONTROLS -->
          <h4 style="font-size: 0.95rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); margin-bottom: 1rem;">Fine-Tune Colors &amp; Glass Intensity</h4>
          <div class="theme-controls-grid">
            <div>
              <div class="admin-form-group">
                <label>Canvas Background Color</label>
                <div style="display: flex; gap: 10px; align-items: center;">
                  <input type="color" id="themeBgColor" value="#08080d" style="width: 50px; height: 42px; border-radius: 8px; border: 1px solid var(--border-glass); background: transparent; cursor: pointer;">
                  <input type="text" id="themeBgColorHex" class="admin-input" value="#08080d" style="flex: 1;">
                </div>
              </div>

              <div class="admin-form-group">
                <label>Primary Accent Glow Color</label>
                <div style="display: flex; gap: 10px; align-items: center;">
                  <input type="color" id="themeAccentColor" value="#8b5cf6" style="width: 50px; height: 42px; border-radius: 8px; border: 1px solid var(--border-glass); background: transparent; cursor: pointer;">
                  <input type="text" id="themeAccentColorHex" class="admin-input" value="#8b5cf6" style="flex: 1;">
                </div>
              </div>

              <div class="admin-form-group">
                <label>Secondary Accent Glow Color</label>
                <div style="display: flex; gap: 10px; align-items: center;">
                  <input type="color" id="themeSecondaryColor" value="#06b6d4" style="width: 50px; height: 42px; border-radius: 8px; border: 1px solid var(--border-glass); background: transparent; cursor: pointer;">
                  <input type="text" id="themeSecondaryColorHex" class="admin-input" value="#06b6d4" style="flex: 1;">
                </div>
              </div>
            </div>

            <div>
              <div class="theme-slider-group">
                <div class="theme-slider-header">
                  <span>Glass Backdrop Blur Intensity</span>
                  <span id="labelGlassBlur">24px</span>
                </div>
                <input type="range" id="sliderGlassBlur" class="theme-range-input" min="8" max="45" value="24">
              </div>

              <div class="theme-slider-group">
                <div class="theme-slider-header">
                  <span>Glass Surface Opacity</span>
                  <span id="labelGlassOpacity">72%</span>
                </div>
                <input type="range" id="sliderGlassOpacity" class="theme-range-input" min="20" max="95" value="72">
              </div>

              <div class="theme-slider-group">
                <div class="theme-slider-header">
                  <span>Ambient Floating Orbs Motion</span>
                  <span id="labelOrbsMotion">Smooth Flow</span>
                </div>
                <select id="selectOrbsMotion" class="admin-input">
                  <option value="smooth">✨ Smooth Ambient Flow (Recommended)</option>
                  <option value="energetic">⚡ High Energy Fluid</option>
                  <option value="calm">🌙 Subtle Calm Drift</option>
                  <option value="disabled">🚫 Disabled (Clean Solid)</option>
                </select>
              </div>

              <div style="margin-top: 1.5rem; display: flex; gap: 1rem;">
                <button class="control-btn" id="btnPreviewTheme" style="flex: 1; padding: 12px; font-weight: 700; border-radius: var(--radius-md);">
                  👁️ Test Live Preview
                </button>
                <button class="glow-btn" id="btnSaveGlassThemeBottom" style="flex: 1; padding: 12px; font-weight: 700; border-radius: var(--radius-md);">
                  💾 Save &amp; Apply Everywhere
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- TAB 6: ABUSE REPORTS -->
      <div class="admin-tab-content studio-tab-content" id="studio-tab-reports">
        <div class="admin-table-wrapper">
          <div class="table-toolbar">
            <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--danger);">Reported User Flagged Desk</h3>
          </div>
          <table class="admin-table">
            <thead>
              <tr>
                <th>Report ID</th>
                <th>Reporter</th>
                <th>Reported User</th>
                <th>Reason</th>
                <th>Details</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="studioReportsTbody"></tbody>
          </table>
        </div>
      </div>

      <!-- TAB 7: AUDIT LOGS -->
      <div class="admin-tab-content studio-tab-content" id="studio-tab-logs">
        <div class="admin-table-wrapper">
          <div class="table-toolbar">
            <h3 style="font-size: 1.1rem; font-weight: 800;">Owner Immutable Audit Trail</h3>
          </div>
          <table class="admin-table">
            <thead>
              <tr>
                <th>Timestamp</th>
                <th>Action</th>
                <th>Target</th>
                <th>Details</th>
                <th>IP Address</th>
              </tr>
            </thead>
            <tbody id="studioLogsTbody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       MOBILE & TABLET BOTTOM FLOATING NAVIGATION BAR
       ========================================================================== -->
  <nav class="mobile-bottom-nav" id="mobileBottomNav">
    <button type="button" class="mobile-nav-item active" id="mNavHome" onclick="window.scrollTo({top: 0, behavior: 'smooth'})">
      <span class="m-nav-icon">🏠</span>
      <span class="m-nav-label">Home</span>
    </button>
    <button type="button" class="mobile-nav-item" id="mNavCall" onclick="pulseApp.handleCategoryClick('stranger')">
      <span class="m-nav-icon">⚡</span>
      <span class="m-nav-label">Start Call</span>
    </button>
    <button type="button" class="mobile-nav-item" id="mNavCoins" onclick="pulseApp.openWalletModal()">
      <span class="m-nav-icon">🪙</span>
      <span class="m-nav-label">Coins</span>
    </button>
    <button type="button" class="mobile-nav-item studio-nav-item" id="mNavStudio" onclick="window.ownerStudio.openStudio()">
      <span class="m-nav-icon">👑</span>
      <span class="m-nav-label">Studio</span>
    </button>
    <button type="button" class="mobile-nav-item" id="mNavProfile" onclick="pulseApp.openProfileModal()">
      <span class="m-nav-icon">👤</span>
      <span class="m-nav-label">Profile</span>
    </button>
  </nav>

  <script src="/js/socket.js?v=8"></script>
  <script src="/js/webrtc.js?v=8"></script>
  <script src="/js/admin.js?v=8"></script>
  <script src="/js/app.js?v=8"></script>

  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js?v=8').catch(() => {});
    }
  </script>
</body>
</html>

  <div class="modal-overlay" id="screenshotModal">
    <div class="glass-panel" style="max-width: 650px; width: 100%; border-radius: var(--radius-lg); padding: 1.5rem; text-align: center;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
        <h4 id="screenshotModalUser" style="font-size:1.1rem; font-weight:800;">Payment Screenshot</h4>
        <button class="control-btn modal-close-btn" style="width:30px; height:30px;">✕</button>
      </div>
      <div style="max-height: 70vh; overflow-y: auto;">
        <img id="screenshotModalImg" style="max-width: 100%; border-radius: 8px;">

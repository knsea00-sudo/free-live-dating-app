  <!-- Schema.org JSON-LD Structured Data for Dating & WebApplication -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "http://localhost:3000/#website",
        "url": "http://localhost:3000/",
        "name": "Random Live Chat",
        "description": "Free random video dating platform connecting strangers and singles worldwide.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "http://localhost:3000/?q={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "WebApplication",
        "@id": "http://localhost:3000/#app",
        "name": "Random Live Chat",
        "applicationCategory": "SocialNetworkingApplication",
        "operatingSystem": "All (Web, Windows, Android, iOS, Tablets)",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Worldwide random live video dating application connecting singles and strangers face-to-face in encrypted HD video chat.",
        "aggregateRating": {
          "@type": "AggregateRating",
          "ratingValue": "4.9",
          "ratingCount": "128450",
          "bestRating": "5"
        }
      },
      {
        "@type": "FAQPage",
        "@id": "http://localhost:3000/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "What is Random Live Chat?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Random Live Chat is a free, high-speed random video dating platform that connects you 1-on-1 with real strangers and attractive singles worldwide via encrypted WebRTC live video."
            }
          },
          {
            "@type": "Question",
            "name": "Can I filter video chat by gender (Female or Male)?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes! You can connect specifically with verified female users, male users, or random strangers. Every new registration receives 200 complimentary coins to test both Male and Female sections freely."
            }
          },
          {
            "@type": "Question",
            "name": "Is Random Live Chat safe and strictly 18+?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes, Random Live Chat strictly enforces an 18+ adult policy with age verification controls, real-time moderation, peer-to-peer encryption, and zero private call recording."
            }
          },
          {
            "@type": "Question",
            "name": "Do I need to download an app to use Random Live Chat?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "No download is required. Random Live Chat works seamlessly across desktop browsers, Android, iPhone/iOS, and tablet devices with one-click instant access."
            }
          }
        ]
      }
    ]
  }
  </script>
</head>
<body>

  <!-- Ambient Floating Glass Orbs Background -->
  <div class="ambient-orbs-container" aria-hidden="true">
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>
    <div class="ambient-orb orb-3"></div>
  </div>

  <!-- ==========================================================================
       MAIN USER APPLICATION VIEW
       ========================================================================== -->
  <div id="mainView">
    <!-- Top Announcement Ticker -->
    <div class="announcement-bar">
      <span>📢</span>
      <span id="announcementText">✨ Welcome to PulseLive! Real live video chat. Register now for 200 free coins!</span>
    </div>

    <!-- App Header -->
    <header class="app-header glass-panel">
      <div class="brand-wrapper" onclick="window.location.reload()">
        <img src="/assets/logo.svg" alt="PulseLive Logo" class="brand-logo" id="headerLogoImg">
      </div>

      <div class="header-actions">
        <!-- Coin Wallet Pill -->
        <div class="coin-pill" id="coinPillBtn" onclick="pulseApp.openWalletModal()" title="View Wallet Balance & History">
          <span class="coin-icon">🪙</span>
          <span class="coin-amount" id="headerCoinCount">200</span>
          <span class="coin-plus" id="buyCoinsBtn" onclick="event.stopPropagation(); pulseApp.openWalletModal()" title="Recharge Coins">+</span>
        </div>

        <!-- VIP Membership Badge -->
        <button class="glow-btn" id="vipUpgradeBtn" onclick="pulseApp.openSubscriptionModal()" style="padding: 6px 14px; border-radius: var(--radius-full); font-size: 0.85rem; display: flex; align-items: center; gap: 6px;">
          <span>👑</span>
          <span id="headerVipBadge">VIP Access</span>
        </button>

        <!-- Customer Support Desk -->
        <button class="control-btn" id="headerSupportBtn" onclick="pulseApp.openSupportModal()" style="width: 36px; height: 36px; font-size: 1rem;" title="Customer Support & Help Center">
          🎧
        </button>

        <!-- OWNER STUDIO (Protected by Security PIN) -->
        <button class="control-btn" id="headerStudioBtn" onclick="window.ownerStudio.openStudio()" style="width: auto; padding: 0 12px; height: 36px; font-size: 0.85rem; font-weight: 800; background: rgba(251, 191, 36, 0.15); border: 1px solid #fbbf24; color: #fbbf24; display: flex; align-items: center; gap: 6px;" title="Owner Studio Command Center">
          <span>👑</span>
          <span>Owner Studio</span>
        </button>

        <!-- User Profile Avatar & Status -->
        <div style="display: flex; align-items: center; gap: 8px;">
          <span id="headerUsername" style="font-size: 0.85rem; font-weight: 700; color: var(--text-main); max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"></span>
          <div class="user-avatar-btn" id="userProfileBtn" onclick="pulseApp.openProfileModal()" title="Your Profile & Settings">
            <img src="https://api.dicebear.com/7.x/bottts/svg?seed=User" alt="Avatar" id="userAvatarImg">
          </div>
        </div>
      </div>
    </header>

    <!-- Main Dashboard Container -->
    <main class="dashboard-container">
      <div class="dashboard-hero">
        <h1>Random Live Chat - Stranger Video Dating</h1>
        <p>Meet attractive singles &amp; talk to strangers worldwide in live 1-on-1 private video calls. Instant match, 100% real humans, strictly 18+.</p>
        
        <!-- Filter Preferences Bar -->
        <div class="filter-bar">
          <span style="font-size: 0.85rem; color: var(--text-dim); font-weight: 700; text-transform: uppercase;">Matching Region:</span>
          <div class="filter-chip active" data-filter="worldwide">
            <span>🌍</span>
            <span>Worldwide</span>
          </div>
          <div class="filter-chip" data-filter="same_country">
            <span>🏠</span>
            <span>Same Country</span>
          </div>
          <div class="filter-chip" data-filter="different_country">
            <span>✈️</span>
            <span>International Only</span>
          </div>
        </div>
      </div>

      <!-- Category Cards Grid (REAL DATA ONLY - NO FAKE COUNTERS) -->
      <div class="categories-grid">
        <!-- 1. STRANGER CATEGORY -->
        <div class="category-card card-stranger glass-panel" data-category="stranger" onclick="pulseApp.handleCategoryClick('stranger')">
          <div class="category-icon-wrapper">
            <span>🌐</span>
          </div>
          <h3>STRANGER</h3>
          <p>Randomly connect with available online users worldwide. Free to match anytime.</p>
          <div class="online-pill">
            <span class="online-dot"></span>
            <span class="real-online-count">0 Online</span>
          </div>
          <button class="glow-btn category-start-btn" onclick="event.stopPropagation(); pulseApp.handleCategoryClick('stranger')">
            ⚡ Start Video Call
          </button>
        </div>

        <!-- 2. FEMALE CATEGORY -->
        <div class="category-card card-female glass-panel" data-category="female" onclick="pulseApp.handleCategoryClick('female')">
          <div class="category-icon-wrapper">
            <span>👩</span>
          </div>
          <h3>FEMALE</h3>
          <p>Connect specifically with verified female users from different regions.</p>
          <div class="online-pill">
            <span class="online-dot"></span>
            <span class="real-online-count">0 Online</span>
          </div>
          <button class="glow-btn category-start-btn" onclick="event.stopPropagation(); pulseApp.handleCategoryClick('female')">
            ⚡ Connect with Female
          </button>
          <div id="femaleCategoryHint" style="margin-top: 10px; font-size: 0.8rem; color: #fbbf24; font-weight: 700;">
            ⚡ 5 Coins / Call (Free Trial Unlocked)
          </div>
        </div>

        <!-- 3. MALE CATEGORY -->
        <div class="category-card card-male glass-panel" data-category="male" onclick="pulseApp.handleCategoryClick('male')">
          <div class="category-icon-wrapper">
            <span>👨</span>
          </div>
          <h3>MALE</h3>
          <p>Connect specifically with verified male users from different regions.</p>
          <div class="online-pill">
            <span class="online-dot"></span>
            <span class="real-online-count">0 Online</span>
          </div>
          <button class="glow-btn category-start-btn" onclick="event.stopPropagation(); pulseApp.handleCategoryClick('male')">
            ⚡ Connect with Male
          </button>
          <div id="maleCategoryHint" style="margin-top: 10px; font-size: 0.8rem; color: #38bdf8; font-weight: 700;">
            ⚡ 5 Coins / Call (Free Trial Unlocked)
          </div>
        </div>
      </div>

      <!-- Trust & Safety Guarantee Banner -->
      <div class="glass-panel" style="padding: 1.5rem 2rem; border-radius: var(--radius-lg); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-top: 2rem;">
        <div style="display: flex; align-items: center; gap: 14px;">
          <div style="font-size: 2rem;">🛡️</div>
          <div>
            <h4 style="font-size: 1.05rem; font-weight: 800; margin-bottom: 2px;">100% Real Users • Strictly 18+ • Privacy Guaranteed</h4>
            <p style="font-size: 0.85rem; color: var(--text-muted);">Encrypted peer-to-peer live communication. Zero private recording. Real live humans.</p>
          </div>
        </div>
        <div style="display: flex; gap: 10px;">
          <button class="btn-sm" style="background: rgba(139, 92, 246, 0.2); color: #fff; font-weight: 700; border: 1px solid var(--accent-primary);" onclick="window.open(window.location.origin, '_blank')">
            🪟 Open 2nd Window to Test Real Call
          </button>
        </div>
      </div>

      <!-- ==========================================
           SEO: WHY SINGLES LOVE RANDOM LIVE CHAT
           ========================================== -->
      <section class="seo-features-grid" aria-label="Key Dating Features">
        <div class="glass-panel seo-feature-card">
          <div style="font-size: 2.2rem;">⚡</div>
          <h3 style="font-size: 1.1rem; font-weight: 800;">Instant Matchmaking</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Connect with random singles within 2 seconds. Zero waiting rooms, no ghosting.</p>
        </div>

        <div class="glass-panel seo-feature-card">
          <div style="font-size: 2.2rem;">👩‍❤️‍👨</div>
          <h3 style="font-size: 1.1rem; font-weight: 800;">Female &amp; Male Filters</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Pick your preference! Match specifically with gorgeous women or handsome men.</p>
        </div>

        <div class="glass-panel seo-feature-card">
          <div style="font-size: 2.2rem;">🌍</div>
          <h3 style="font-size: 1.1rem; font-weight: 800;">Worldwide &amp; Local</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Meet local singles near you or explore foreign partners from 120+ countries.</p>
        </div>

        <div class="glass-panel seo-feature-card">
          <div style="font-size: 2.2rem;">🛡️</div>
          <h3 style="font-size: 1.1rem; font-weight: 800;">100% Real Live Humans</h3>
          <p style="font-size: 0.85rem; color: var(--text-muted);">Strictly zero fake bots. Every connected call is a living, breathing human being.</p>
        </div>
      </section>

      <!-- ==========================================
           SEO: KEYWORD-RICH DATING ARTICLE & GUIDE
           ========================================== -->
      <article class="glass-panel seo-content-article" itemscope itemtype="https://schema.org/Article">
        <header>
          <h2 itemprop="headline">Random Live Chat: The Premier Worldwide Video Dating Experience for Strangers</h2>
          <p itemprop="description">Tired of endless swiping and boring text chats on dating apps that lead nowhere? <strong>Random Live Chat</strong> brings real romance and genuine chemistry back to the forefront with spontaneous, face-to-face live video dating with strangers.</p>
        </header>

        <section>
          <h3>🔥 Face-to-Face Chemistry: Real Reactions, Real Romance</h3>
          <p>Texting hides emotions, but live video reveals genuine laughs, smiles, and eye contact. Whether you're looking for exciting romance, casual flirtation, or finding new international friends, Random Live Chat provides the fastest and most secure platform to meet singles online.</p>

          <h3>👩 Free Female &amp; Male Match Filters</h3>
          <p>Unlike old-fashioned chat sites that leave matchmaking purely to chance, Random Live Chat gives you full control. Every new eligible user receives <strong>200 complimentary coins</strong> upon registration to test both Female and Male matching rooms freely. Find your dream stranger today!</p>

          <h3>🔒 Discretion, Anonymity &amp; Top-Tier Privacy</h3>
          <p>Your privacy is our number one priority. All video calls are streamed directly peer-to-peer using WebRTC technology, ensuring your calls are never saved or recorded. Plus, our automated moderation shield strictly enforces an <strong>18+ community policy</strong> to ensure safe and respectful interactions for all users.</p>
        </section>
      </article>

      <!-- ==========================================
           SEO: FREQUENTLY ASKED QUESTIONS (FAQ)
           ========================================== -->
      <section class="seo-faq-container" aria-label="Frequently Asked Questions">
        <h2 style="font-size: 1.6rem; font-weight: 900; text-align: center; margin-bottom: 1.5rem; background: var(--accent-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
          Frequently Asked Questions About Random Live Chat
        </h2>

        <div class="glass-panel seo-faq-item">
          <div class="seo-faq-question" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'">
            <span>❓ How does Random Live Chat video dating work?</span>
            <span style="color: var(--accent-secondary);">▼</span>
          </div>
          <div class="seo-faq-answer" style="display: block;">
            Random Live Chat pairs you 1-on-1 with available strangers based on your selected matching filters (Worldwide, Same Country, or Gender). Simply click 'Start Video Call' on any category card, and our instant matchmaking algorithm connects your camera in seconds.
          </div>
        </div>

        <div class="glass-panel seo-faq-item">
          <div class="seo-faq-question" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'">
            <span>❓ Can I chat specifically with girls or guys?</span>
            <span style="color: var(--accent-secondary);">▼</span>
          </div>
          <div class="seo-faq-answer" style="display: none;">
            Yes! You can choose the FEMALE or MALE category cards. Every new user receives 200 complimentary trial coins to check out both sections freely. Once trial coins are exhausted, you can upgrade to VIP subscription or recharge coins to keep matching with your preferred gender.
          </div>
        </div>

        <div class="glass-panel seo-faq-item">
          <div class="seo-faq-question" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'">
            <span>❓ Is Random Live Chat really free for strangers?</span>
            <span style="color: var(--accent-secondary);">▼</span>
          </div>
          <div class="seo-faq-answer" style="display: none;">
            Yes! The Stranger category is 100% free to use anytime, even with 0 coins in your wallet. You also receive 200 free coins on signup to try premium gender-filtered calls without paying upfront.
          </div>
        </div>

        <div class="glass-panel seo-faq-item">
          <div class="seo-faq-question" onclick="this.nextElementSibling.style.display = this.nextElementSibling.style.display === 'none' ? 'block' : 'none'">
            <span>❓ Are video calls recorded or stored?</span>
            <span style="color: var(--accent-secondary);">▼</span>
          </div>
          <div class="seo-faq-answer" style="display: none;">
            Never. All calls use end-to-end WebRTC peer-to-peer data channels. Video and audio streams go directly between your device and your partner's device without passing through recording servers.
          </div>
        </div>
      </section>

      <!-- ==========================================
           SEO: SEARCH-ENGINE OPTIMIZED FOOTER
           ========================================== -->
      <footer class="seo-footer" role="contentinfo">
        <div style="display: flex; justify-content: center; gap: 2rem; flex-wrap: wrap; margin-bottom: 1.5rem; font-size: 0.9rem; font-weight: 700;">
          <a href="/random-live-chat" style="color: var(--text-main); text-decoration: none;">Random Live Chat</a>
          <a href="/dating" style="color: var(--text-main); text-decoration: none;">Video Dating</a>
          <a href="/strangers" style="color: var(--text-main); text-decoration: none;">Stranger Cam</a>
          <a href="javascript:void(0)" onclick="window.pulseApp.openSupportModal()" style="color: var(--text-muted); text-decoration: none;">Support Desk</a>
          <a href="javascript:void(0)" onclick="window.pulseApp.openSubscriptionModal()" style="color: #fbbf24; text-decoration: none;">VIP Plans</a>
        </div>

        <div style="display: flex; justify-content: center; align-items: center; gap: 8px; margin-bottom: 1rem;">
          <span style="background: rgba(239, 68, 68, 0.2); color: #ef4444; border: 1px solid #ef4444; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 900;">18+ STRICTLY</span>
          <span style="color: var(--text-dim); font-size: 0.85rem;">Safe &amp; Encrypted Random Stranger Video Dating Platform</span>
        </div>

        <p style="color: var(--text-dim); font-size: 0.8rem; max-width: 650px; margin: 0 auto; line-height: 1.5;">
          Random Live Chat connects consenting adults (18+) worldwide. Inappropriate behavior, harassment, or underage access results in immediate and permanent hardware ban.
          <br>
          &copy; 2026 <strong>Random Live Chat</strong>. All rights reserved.
        </p>

    </main>
  </div>

  <!-- ==========================================================================
       AUTHENTICATION & REGISTRATION MODAL (GOOGLE, FACEBOOK, EMAIL)
       ========================================================================== -->
  <div class="modal-overlay" id="authModal">
    <div class="glass-panel auth-card-container">
      <div style="text-align: center; margin-bottom: 1.25rem;">
        <h3 style="font-size: 1.6rem; font-weight: 900; margin-bottom: 4px;">Welcome to <span class="brand-name-display">Random Live Chat</span></h3>
        <p style="color: var(--text-muted); font-size: 0.85rem;">Connect with real strangers worldwide • 200 Complimentary Coins</p>
      </div>

      <!-- Prominent Tab Switcher -->
      <div class="auth-tabs-nav">
        <button type="button" class="auth-tab-btn active" id="authTabLogin" onclick="pulseApp.switchAuthTab('login')">
          🔑 Log In
        </button>
        <button type="button" class="auth-tab-btn" id="authTabRegister" onclick="pulseApp.switchAuthTab('register')">
          ✨ New Account (200 Coins)
        </button>
      </div>

      <!-- Status / Error Notification Box -->
      <div id="authInlineAlert" style="display: none; padding: 10px 14px; border-radius: 10px; margin-bottom: 1rem; font-size: 0.85rem; font-weight: 600; text-align: center;"></div>

      <!-- Quick 1-Click Social Sign-in Options -->
      <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.25rem;">
        <!-- Google Button -->
        <button type="button" class="social-login-btn google-btn" id="googleAuthTriggerBtn" onclick="pulseApp.loginWithGoogle()">
          <svg width="20" height="20" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>
          <span>Continue with Google (Gmail)</span>
        </button>

        <!-- Google Drawer (Expanded on Click) -->
        <div id="googleSignInDrawer" style="display: none; background: rgba(0, 0, 0, 0.4); border: 1px solid rgba(234, 67, 53, 0.3); border-radius: 12px; padding: 14px; margin-top: -4px;">
          <!-- CUSTOM GMAIL INPUT -->
          <div style="font-size: 0.78rem; color: var(--text-dim); margin-bottom: 6px;">Enter your Gmail address:</div>
          <div style="display: flex; gap: 8px;">
            <input type="email" id="googleCustomEmailInput" class="admin-input" placeholder="yourname@gmail.com" style="flex: 1; padding: 8px 12px; font-size: 0.85rem;">
            <button type="button" class="glow-btn" style="padding: 8px 14px; font-size: 0.85rem; border-radius: 8px;" onclick="pulseApp.submitCustomGmail()">
              Sign In
            </button>
          </div>
        </div>

        <!-- Facebook Button -->
        <button type="button" class="social-login-btn facebook-btn" id="facebookAuthBtn" onclick="pulseApp.loginWithFacebook()">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="#ffffff"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          <span>Continue with Facebook</span>
        </button>

        <!-- 1-Click Instant Guest Account -->
        <button type="button" class="control-btn" style="width: 100%; border-radius: var(--radius-md); font-size: 0.85rem; font-weight: 700; padding: 10px; border: 1px dashed var(--accent-secondary); color: var(--accent-secondary); background: rgba(6, 182, 212, 0.08);" onclick="pulseApp.quickGuestLogin()">
          ⚡ Quick 1-Click Guest Access (200 Free Coins)
        </button>
      </div>

      <div style="text-align: center; color: var(--text-dim); font-size: 0.75rem; margin-bottom: 1.25rem; position: relative;">
        <span>── OR WITH EMAIL &amp; PASSWORD ──</span>
      </div>

      <!-- FORM 1: EMAIL LOGIN FORM -->
      <div id="authLoginFormSection" style="display: block;">
        <div class="admin-form-group">
          <label>Email Address</label>
          <input type="email" id="loginEmail" class="admin-input" placeholder="name@gmail.com" autocomplete="email">
        </div>
        <div class="admin-form-group">
          <label>Password</label>
          <input type="password" id="loginPassword" class="admin-input" placeholder="Enter your password" autocomplete="current-password">
        </div>
        <button type="button" class="glow-btn" id="submitLoginBtn" style="width: 100%; padding: 12px; border-radius: var(--radius-md); font-size: 0.95rem; margin-top: 10px;" onclick="pulseApp.loginWithEmail()">
          🚀 Log In to Account
        </button>
      </div>

      <!-- FORM 2: EMAIL REGISTRATION FORM -->
      <div id="authRegisterFormSection" style="display: none;">
        <div class="admin-form-group">
          <label>Email Address</label>
          <input type="email" id="regEmail" class="admin-input" placeholder="name@gmail.com" autocomplete="email">
        </div>
        <div class="admin-form-group">
          <label>Create Password</label>
          <input type="password" id="regPassword" class="admin-input" placeholder="Create a strong password" autocomplete="new-password">
        </div>
        <div class="admin-form-group">
          <label>Full Name / Display Name (Optional)</label>
          <input type="text" id="regUsername" class="admin-input" placeholder="Your name">
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
          <div class="admin-form-group">
            <label>Date of Birth (18+)</label>
            <input type="date" id="regDob" class="admin-input" value="2000-01-01">
          </div>
          <div class="admin-form-group">
            <label>Gender</label>
            <select id="regGender" class="admin-select">
              <option value="male">Male</option>
              <option value="female">Female</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>
        <div class="admin-form-group">
          <label>Country</label>
          <input type="text" id="regCountry" class="admin-input" value="India">
        </div>

        <button type="button" class="glow-btn" id="submitRegisterBtn" style="width: 100%; padding: 12px; border-radius: var(--radius-md); font-size: 0.95rem; margin-top: 10px;" onclick="pulseApp.registerWithEmail()">
          🚀 Create Account &amp; Claim 200 Coins
        </button>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       RADAR MATCHMAKING MODAL (REAL HUMANS ONLY)
       ========================================================================== -->
  <div class="modal-overlay" id="radarModal">
    <div class="radar-modal-content glass-panel">
      <div class="radar-screen">
        <div class="radar-ring"></div>
        <div class="radar-ring"></div>
        <div class="radar-ring"></div>
        <div class="radar-sweep"></div>
        <div class="radar-user-icon">📡</div>
      </div>
      <h3 id="radarCategoryLabel" style="font-size: 1.5rem; font-weight: 900; margin-bottom: 0.5rem;">SEARCHING REAL MATCH</h3>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1rem;">
        Waiting for another online person to connect...
      </p>
      <div style="margin-bottom: 1.5rem; font-size: 0.85rem; color: #10b981; font-weight: 700;" id="radarOnlineCount">
        1 Active Human Online
      </div>

      <!-- Quick Multi-Window Test Helper -->
      <div style="background: rgba(255,255,255,0.04); border-radius: var(--radius-md); padding: 12px; margin-bottom: 1.5rem; font-size: 0.85rem; line-height: 1.4;">
        <span>💡 Testing solo right now? Click below to open a 2nd window and connect to yourself in live 2-way WebRTC!</span>
        <button class="btn-sm" style="background: var(--accent-primary); color: #fff; width: 100%; margin-top: 8px; padding: 8px; border-radius: var(--radius-sm); font-weight: 800;" onclick="window.open(window.location.origin, '_blank')">
          🪟 Open 2nd Window to Test Real Call
        </button>
      </div>
      
      <button class="control-btn btn-danger-sm" id="cancelRadarBtn" style="width: auto; padding: 10px 24px; border-radius: var(--radius-full); margin: 0 auto; display: block; font-size: 0.95rem;">
        Cancel Search
      </button>
    </div>
  </div>

  <!-- ==========================================================================
       FULLSCREEN LIVE VIDEO CALLING ROOM
       ========================================================================== -->
  <div class="call-container" id="callContainer" style="display: none;">
    <div class="call-top-bar">
      <div class="call-partner-info">
        <div class="partner-avatar">
          <img src="" alt="Partner" id="partnerAvatarImg" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div class="partner-details">
          <h4 id="partnerDisplayName">Partner Name</h4>
          <div class="partner-country-tag" id="partnerCountryTag">🌍 Country</div>
        </div>
      </div>

      <div class="call-meta-badges">
        <div class="call-timer-badge">
          <span>⏱️</span>
          <span id="callDurationTimer">00:00</span>
        </div>
        <div class="coin-pill" style="padding: 4px 12px;">
          <span class="coin-icon">🪙</span>
          <span class="coin-amount" id="callCoinCount">195</span>
        </div>
        <div class="quality-badge">Live HD</div>
      </div>
    </div>

    <div class="remote-video-wrapper">
      <video id="remoteVideoFeed" class="remote-video-feed" autoplay playsinline></video>
    </div>

    <div class="local-pip-wrapper" id="localPipWrapper" title="Drag to reposition">
      <video id="localVideoFeed" class="local-pip-feed" autoplay playsinline muted></video>
    </div>

    <div class="call-bottom-controls">
      <button class="control-btn" id="btnMuteAudio" title="Mute/Unmute Mic (M)">🎙️</button>
      <button class="control-btn" id="btnToggleVideo" title="Camera On/Off (V)">📹</button>
      <button class="control-btn" id="btnFlipCamera" title="Flip Camera">🔄</button>
      <button class="control-btn" id="btnReportCall" style="color: var(--warning);" title="Report User">🚩</button>
      <button class="control-btn" id="btnBlockCall" style="color: var(--danger);" title="Block User">🚫</button>
      
      <button class="control-btn btn-next" id="btnNextStranger" title="Next Stranger (Space)">
        <span>Next</span>
        <span>⏭️</span>
      </button>
      
      <button class="control-btn btn-end" id="btnEndCall" title="End Call (E)">
        🛑
      </button>
    </div>
  </div>

  <!-- ==========================================================================
       COIN WALLET & RECHARGE MODAL
       ========================================================================== -->
  <div class="modal-overlay" id="walletModal">
    <div class="glass-panel" style="max-width: 600px; width: 100%; border-radius: var(--radius-lg); padding: 2rem; max-height: 90vh; overflow-y: auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.5rem; font-weight: 900; display: flex; align-items: center; gap: 8px;">
          <span>🪙</span>
          <span>Coin Wallet</span>
        </h3>
        <button class="control-btn modal-close-btn" style="width: 32px; height: 32px;">✕</button>
      </div>

      <div style="background: rgba(251, 191, 36, 0.1); border: 1px solid rgba(251, 191, 36, 0.3); border-radius: var(--radius-md); padding: 1.25rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Total Balance</div>
          <div style="font-size: 2rem; font-weight: 900; color: #fbbf24;" id="modalWalletBalance">200 Coins</div>
        </div>
        <div style="text-align: right; font-size: 0.85rem;">
          <div id="modalFreeCoins" style="color: #10b981; font-weight: 700;">200 Free</div>
          <div id="modalPurchasedCoins" style="color: var(--text-muted);">0 Purchased</div>
        </div>
      </div>

      <h4 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem;">Purchase Coin Packages</h4>
      <div id="walletPackagesGrid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-bottom: 2rem;"></div>

      <h4 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem;">Transaction History</h4>
      <div id="walletTxList" style="max-height: 180px; overflow-y: auto;"></div>
    </div>
  </div>

  <!-- ==========================================================================
       VIP SUBSCRIPTION MODAL
       ========================================================================== -->
  <div class="modal-overlay" id="subscriptionModal">
    <div class="glass-panel" style="max-width: 800px; width: 100%; border-radius: var(--radius-lg); padding: 2rem; max-height: 90vh; overflow-y: auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <div>
          <h3 style="font-size: 1.6rem; font-weight: 900; display: flex; align-items: center; gap: 8px;">
            <span>👑</span>
            <span>PulseLive VIP Subscription</span>
          </h3>
          <p style="color: var(--text-muted); font-size: 0.9rem;">Unlock exclusive Male and Female video matching categories.</p>
        </div>
        <button class="control-btn modal-close-btn" style="width: 32px; height: 32px;">✕</button>
      </div>

      <div id="subscriptionPlansGrid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;"></div>
    </div>
  </div>

  <!-- ==========================================================================
       PAYMENT CHECKOUT WITH SCREENSHOT UPLOAD & UTR VERIFICATION
       ========================================================================== -->
  <div class="modal-overlay" id="checkoutModal">
    <div class="glass-panel" style="max-width: 520px; width: 100%; border-radius: var(--radius-lg); padding: 2rem; max-height: 92vh; overflow-y: auto;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.4rem; font-weight: 900;">Complete Payment</h3>
        <button class="control-btn modal-close-btn" style="width: 32px; height: 32px;">✕</button>
      </div>

      <div style="background: rgba(255, 255, 255, 0.04); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
        <div>
          <div id="checkoutItemLabel" style="font-weight: 800; font-size: 1rem;">Package</div>
          <div style="font-size: 0.8rem; color: var(--text-muted);">Verified Owner Activation</div>
        </div>
        <div style="text-align: right;">
          <div id="checkoutAmountInr" style="font-weight: 900; font-size: 1.3rem; color: #10b981;">₹0</div>
          <div id="checkoutAmountUsd" style="font-size: 0.85rem; color: var(--text-muted);">$0.00</div>
        </div>
      </div>

      <!-- UPI QR Scanner -->
      <div style="border: 1px solid var(--border-glass); border-radius: var(--radius-md); padding: 1.25rem; margin-bottom: 1.5rem; text-align: center; background: rgba(0, 0, 0, 0.25);">
        <h4 style="font-size: 0.95rem; font-weight: 800; margin-bottom: 8px; color: #fbbf24;">
          ⚡ Step 1: Scan &amp; Pay via UPI (GPay / PhonePe / Paytm / BHIM)
        </h4>
        <div style="width: 180px; height: 180px; margin: 0 auto 10px; border-radius: var(--radius-md); overflow: hidden; border: 2px solid #fbbf24; box-shadow: 0 0 20px rgba(251, 191, 36, 0.3);">
          <img id="checkoutQrImg" src="/assets/payment-qr.jpg" alt="UPI Payment QR Code" style="width: 100%; height: 100%; object-fit: cover;">
        </div>
        <div style="font-size: 0.85rem; color: var(--text-muted);">
          UPI ID: <strong id="checkoutUpiId" style="color:#fff;">pulselive@upi</strong>
        </div>
      </div>

      <!-- Step 2: Payment Proof Submission (UTR & Screenshot Upload) -->
      <div style="border: 1px solid var(--border-glass); border-radius: var(--radius-md); padding: 1.25rem; background: rgba(0, 0, 0, 0.35);">
        <h4 style="font-size: 0.95rem; font-weight: 800; margin-bottom: 12px; color: #10b981;">
          📸 Step 2: Submit Payment Screenshot &amp; UTR
        </h4>

        <div class="admin-form-group">
          <label>12-Digit UPI UTR / Transaction Reference Number</label>
          <input type="text" id="checkoutUtrInput" class="admin-input" placeholder="e.g. 432198765432">
        </div>

        <div class="admin-form-group">
          <label>Attach Payment Screenshot / Receipt</label>
          <input type="file" id="checkoutScreenshotInput" accept="image/*" class="admin-input" onchange="pulseApp.handleScreenshotFile(event)">
        </div>

        <div id="screenshotPreviewBox" style="display: none; margin-bottom: 1rem; text-align: center;">
          <img id="screenshotPreviewImg" style="max-height: 120px; border-radius: 6px; border: 1px solid var(--accent-primary);">
        </div>

        <button class="glow-btn" style="width: 100%; padding: 12px; border-radius: var(--radius-md); font-size: 0.95rem;" onclick="pulseApp.submitPaymentProof()">
          🚀 Submit Payment Proof for Verification
        </button>
        <small style="display:block; text-align:center; color:var(--text-dim); margin-top:8px; font-size:0.75rem;">
          The Owner verifies your bank payment and activates your account benefits immediately!
        </small>
      </div>
    </div>
  </div>

  <!-- ==========================================================================
       USER PROFILE & SETTINGS MODAL
       ========================================================================== -->
  <div class="modal-overlay" id="profileModal">
    <div class="glass-panel" style="max-width: 480px; width: 100%; border-radius: var(--radius-lg); padding: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.4rem; font-weight: 900;">User Profile</h3>
        <button class="control-btn modal-close-btn" style="width: 32px; height: 32px;">✕</button>
      </div>

      <div style="text-align: center; margin-bottom: 1.5rem;">
        <h4 id="profileUsername" style="font-size: 1.2rem; font-weight: 800;">Username</h4>
        <div id="profileEmail" style="color: var(--accent-secondary); font-size: 0.85rem;">user@gmail.com</div>
        <div id="profileUserId" style="color: var(--text-dim); font-size: 0.8rem; font-family: monospace;">PL-000000</div>
        <div style="margin-top: 8px;">
          <span class="badge badge-active" id="profileStatusBadge">Standard Member</span>
        </div>
      </div>

      <div style="background: rgba(0,0,0,0.3); border-radius: var(--radius-md); padding: 1rem; font-size: 0.9rem; line-height: 2; margin-bottom: 1.5rem;">
        <div><strong>Country:</strong> <span id="profileCountry">India (IN)</span></div>
        <div><strong>Gender:</strong> <span id="profileGender">Other</span></div>
        <div><strong>Date of Birth:</strong> <span id="profileDob">2000-01-01</span></div>
      </div>

      <button class="control-btn btn-danger-sm" style="width: 100%; padding: 10px; border-radius: var(--radius-md);" onclick="localStorage.removeItem('pulselive_user'); window.location.reload();">
        Secure Logout
      </button>
    </div>
  </div>

  <!-- ==========================================================================
       CUSTOMER SUPPORT MODAL
       ========================================================================== -->
  <div class="modal-overlay" id="supportModal">
    <div class="glass-panel" style="max-width: 500px; width: 100%; border-radius: var(--radius-lg); padding: 2rem;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.4rem; font-weight: 900;">Support Desk</h3>
        <button class="control-btn modal-close-btn" style="width: 32px; height: 32px;">✕</button>
      </div>

      <div class="admin-form-group">
        <label>Subject</label>
        <input type="text" id="supportSubject" class="admin-input" placeholder="e.g. Payment or account issue">
      </div>

      <div class="admin-form-group">
        <label>Category</label>
        <select id="supportCategory" class="admin-select">
          <option value="payment">Payment / Wallet Issue</option>
          <option value="account">Account Access</option>
          <option value="technical">Video / Audio Issue</option>
          <option value="safety">Report Abuse</option>
        </select>
      </div>

      <div class="admin-form-group">
        <label>Message</label>
        <textarea id="supportMessage" class="admin-textarea" placeholder="Describe the issue in detail..."></textarea>
      </div>

      <button class="glow-btn" style="width: 100%; padding: 12px; border-radius: var(--radius-md);" onclick="pulseApp.submitSupportTicket()">
        Submit Support Ticket
      </button>
    </div>
  </div>

  <!-- ==========================================================================
       REPORT CALL MODAL
       ========================================================================== -->
  <div class="modal-overlay" id="reportModal">
    <div class="glass-panel" style="max-width: 440px; width: 100%; border-radius: var(--radius-lg); padding: 2rem; text-align: center;">
      <h3 style="font-size: 1.4rem; font-weight: 900; margin-bottom: 0.5rem; color: var(--danger);">Report User</h3>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1.5rem;">Report <span id="reportPartnerName" style="color:#fff; font-weight:700;">Partner</span> for community violations.</p>

      <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 1.5rem;">
        <button class="control-btn" style="border-radius: var(--radius-md); font-size: 0.9rem; padding: 10px; width: 100%; text-align: left;" onclick="pulseApp.submitReport('Inappropriate / Nudity')">
          🚫 Inappropriate / Nudity
        </button>
        <button class="control-btn" style="border-radius: var(--radius-md); font-size: 0.9rem; padding: 10px; width: 100%; text-align: left;" onclick="pulseApp.submitReport('Underage Suspect')">
          🔞 Suspected Underage User
        </button>
        <button class="control-btn" style="border-radius: var(--radius-md); font-size: 0.9rem; padding: 10px; width: 100%; text-align: left;" onclick="pulseApp.submitReport('Harassment / Abuse')">
          ⚠️ Harassment or Abusive Conduct
        </button>
        <button class="control-btn" style="border-radius: var(--radius-md); font-size: 0.9rem; padding: 10px; width: 100%; text-align: left;" onclick="pulseApp.submitReport('Spam / Commercial Bot')">
          🤖 Spam or Automated Bot
        </button>
      </div>

      <button class="control-btn modal-close-btn" style="width: 100%; border-radius: var(--radius-md); padding: 8px;">
        Cancel
      </button>
    </div>
  </div>

  <!-- ==========================================================================
